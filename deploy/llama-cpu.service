[Unit]
Description=CPU-only GGUF inference server
After=network.target
Conflicts=llama-npu.service llama-vulkan.service
RequiresMountsFor=/srv/ai-models

[Service]
Type=simple
User=ai
WorkingDirectory=/var/cache/rk-llama
Environment=HOME=/var/cache/rk-llama
Environment=XDG_CACHE_HOME=/var/cache/rk-llama
ExecStart=/opt/rk-llama.cpp/build-cpu/bin/llama-server --models-dir /srv/ai-models --models-max 1 --host 127.0.0.1 --port 11436 --device none --n-gpu-layers 0 --no-kv-offload --no-op-offload -t 4 --ctx-size 512 -b 64 -ub 64 --sleep-idle-seconds 300
Restart=on-failure
RestartSec=5
LimitNOFILE=102400
CPUAffinity=4 5 6 7
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
