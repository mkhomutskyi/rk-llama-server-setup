[Unit]
Description=Open WebUI for local Rockchip inference
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target systemd-time-wait-sync.service docker.service llama-npu.service
Requires=docker.service llama-npu.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/open-webui
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 600
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=1800
TimeoutStopSec=120
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
